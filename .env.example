# ── PSN link ──────────────────────────────────────────────────────────────
# Grab your NPSSO token once while logged into playstation.com:
#   1. Log in at https://www.playstation.com
#   2. Visit https://ca.account.sony.com/api/v1/ssocookie
#   3. Copy the 64-char "npsso" value below
NPSSO=

# Your PSN online ID (your gamertag). Used to resolve your account for
# presence + trophies. Leave blank to track the token owner's own account.
PSN_ONLINE_ID=

# ── Poller cadence ────────────────────────────────────────────────────────
PRESENCE_POLL_SECONDS=60
TROPHY_SYNC_HOURS=6

# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
DB_PATH=./data/combat-record.db

# ── OCR ───────────────────────────────────────────────────────────────────
# tesseract = local, free. claude = Claude vision API (more robust on game UI).
# auto = try claude if ANTHROPIC_API_KEY is set, fall back to tesseract.
OCR_ENGINE=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Regex used to match Black Ops titles in PSN presence / trophy lists.
TITLE_MATCH=black ops
