# ── PSN link ──────────────────────────────────────────────────────────────
# Grab your NPSSO token once while logged into playstation.com:
#   1. Log in at https://www.playstation.com
#   2. Visit https://ca.account.sony.com/api/v1/ssocookie
#   3. Copy the 64-char "npsso" value below
NPSSO=

# Your PSN online ID (your gamertag). Used to resolve your account for
# presence + trophies. Leave blank to track the token owner's own account.
PSN_ONLINE_ID=

# ── Poller cadence ────────────────────────────────────────────────────────
PRESENCE_POLL_SECONDS=60
TROPHY_SYNC_HOURS=6

# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
DB_PATH=./data/combat-record.db

# ── OCR ───────────────────────────────────────────────────────────────────
# tesseract = local, free. claude = Claude vision API (more robust on game UI).
# auto = try claude if ANTHROPIC_API_KEY is set, fall back to tesseract.
OCR_ENGINE=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Regex used to match Black Ops titles in PSN presence / trophy lists.
TITLE_MATCH=black ops

# ── Auto-ingest (zero-touch screenshot collection) ────────────────────────
# There is no Activision API for BO1/BO2 (Elite shut down in 2014), so this is
# the max automation possible: point this at any folder your capture pipeline
# writes into (capture-card auto-saves, OBS screenshot hotkey, a Dropbox or
# Syncthing folder synced from your phone). Every image that appears is OCR'd
# and filed automatically — end-of-match screens become per-map stats,
# combat-record screens become lifetime snapshots. Leave empty to disable.
AUTO_INGEST_DIR=
